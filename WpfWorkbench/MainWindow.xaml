<Window x:Class="DeviceWorkbench.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="设备工作台" Width="1460" Height="880" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,16">
                <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="6,0">
                    <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="设备工作台" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="WORKSPACE" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="HomeButton" Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="6">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="我的设备"/></StackPanel>
                        </Button>
                        <StackPanel x:Name="DeviceSection" Visibility="Collapsed">
                            <TextBlock x:Name="DeviceNameLabel" Style="{StaticResource SectionLabel}" TextTrimming="CharacterEllipsis"/>
                            <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="实时监视"/></StackPanel></Button>
                            <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="1"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="RS485 传感器"/></StackPanel></Button>
                            <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="2"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="程序编译器"/></StackPanel></Button>
                            <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="3"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="趋势分析"/></StackPanel></Button>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,16,8,0"/>
                        <TextBlock Text="通用工具" Style="{StaticResource SectionLabel}"/>
                        <Button x:Name="SerialButton" Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="4"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="串口"/></StackPanel></Button>
                        <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="5"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9CE;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="通信测试"/></StackPanel></Button>
                        <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="7"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="CAN 报文"/></StackPanel></Button>
                        <Button Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="通信工具箱"/></StackPanel></Button>
                        <Button x:Name="ErrorAnalysisButton" Style="{StaticResource NavigationButton}" Click="NavigationClick" CommandParameter="9"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="30"/><TextBlock Text="数据误差分析"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="设备工作台" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="12,8"/>
            </Grid>
        </Border>
        <wfi:WindowsFormsHost x:Name="WorkspaceHost" Grid.Column="1" Margin="8,6,8,8"/>
    </Grid>
</Window>
