<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IndustrialFieldDataAcquisitionTerminal</RootNamespace>
    <AssemblyName>IndustrialFieldDataAcquisitionTerminal</AssemblyName>
    <ApplicationTitle>设备工作台</ApplicationTitle>
    <ApplicationIcon>Assets\daq-workbench.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="WpfWorkbench\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Pcan\**\PCANBasic.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="Assets\daq-workbench.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Library\*.h" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Update="Docs\编程手册.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <None Update="Docs\误差分析说明.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
